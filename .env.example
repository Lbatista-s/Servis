# ── API simulada ─────────────────────────────────────────────────────────────
# "true" (por defecto): la API la responde un servidor simulado (MSW) dentro
#         del navegador, con los datos de ejemplo. Es lo que usa el despliegue
#         de Vercel mientras no haya backend.
# "false": las peticiones van al backend de Django. Ver docs/integracion.md.
VITE_API_MOCK=true

# ── API real ─────────────────────────────────────────────────────────────────
# Raíz de la API vista desde el navegador. Con "/api" (recomendado) el proxy de
# Vite en desarrollo y un rewrite en Vercel reenvían las peticiones a Django,
# así el navegador sólo ve un origen: sin CORS y con cookies de sesión.
VITE_API_BASE_URL=/api

# Autenticación de la API: "sesion" (cookie de sesión + CSRF de Django) o
# "jwt" (djangorestframework-simplejwt).
VITE_API_AUTH=sesion

# Sólo en desarrollo con VITE_API_MOCK=false: adónde reenvía el proxy de Vite
# las peticiones a /api (el `runserver` de Django).
VITE_API_PROXY=http://localhost:8000
